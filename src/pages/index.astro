---
import Layout from '~/layouts/PageLayout.astro';

import Hero from '~/components/widgets/Hero.astro';
import Features from '~/components/widgets/Features.astro';
import QuickStart from '~/components/widgets/QuickStart.astro';
import Features2 from '~/components/widgets/Features2.astro';
import Timeline from '~/components/widgets/Timeline.astro';
import Steps from '~/components/widgets/Steps.astro';
import Content from '~/components/widgets/Content.astro';
import BlogHighlightedPosts from '~/components/widgets/BlogHighlightedPosts.astro';
import FAQs from '~/components/widgets/FAQs.astro';
import Stats from '~/components/widgets/Stats.astro';
import CallToAction from '~/components/widgets/CallToAction.astro';
import SocialProof from '~/components/widgets/SocialProof.astro';
import StructuredData from '~/components/common/StructuredData.astro';
import { SITE, METADATA, I18N } from 'astrowind:config';
import favIconSvg from '~/assets/favicons/favicon.svg';

const metadata = {
  title: 'AstroWind 中文站 — 免费开源的 Astro v7 + Tailwind CSS v4 网站模板',
  ignoreTitleTemplate: true,
};

// 站点与发布者的结构化数据，全部来自 src/config.yaml
// site.site 是对外域名，base 为部署子路径（自定义域根部署时为 '/'）。
const siteUrl = new URL(SITE?.base || '/', SITE?.site).toString().replace(/\/$/, '');
const organizationId = `${siteUrl}/#organization`;
const structuredData = [
  {
    '@context': 'https://schema.org',
    '@type': 'WebSite',
    '@id': `${siteUrl}/#website`,
    name: SITE?.name,
    url: siteUrl,
    description: METADATA?.description,
    inLanguage: I18N?.language,
    publisher: { '@id': organizationId },
  },
  {
    '@context': 'https://schema.org',
    '@type': 'Organization',
    '@id': organizationId,
    name: SITE?.name,
    url: siteUrl,
    logo: new URL(favIconSvg.src, siteUrl).toString(),
    ...(METADATA?.twitter?.handle ? { sameAs: [`https://x.com/${METADATA.twitter.handle.replace(/^@/, '')}`] } : {}),
  },
];
---

<Layout metadata={metadata}>
  <StructuredData slot="head" schema={structuredData} />

  <!-- Hero -->
  <Hero
    tagline="免费 · 开源 · 生产可用"
    actions={[
      {
        variant: 'primary',
        text: '获取模板',
        href: 'https://github.com/arthelokyo/astrowind',
        target: '_blank',
        icon: 'tabler:download',
      },
      { text: '了解特性', href: '#features' },
    ]}
    image={{ src: '~/assets/images/hero-image.png', alt: 'AstroWind 模板首页示意图' }}
  >
    <Fragment slot="title">
      用 <span class="text-accent dark:text-white">Astro v7</span> +
      <span class="whitespace-nowrap">Tailwind CSS v4</span> 搭网站的免费模板
    </Fragment>

    <Fragment slot="subtitle">
      <span class="font-semibold">AstroWind</span> 是一套免费、可定制、可直接上线的开源模板。内置 30+ 可组合页面区块、
      Markdown/MDX 博客、SEO 元信息、暗色模式与图片优化，适合创业团队、SaaS 官网、作品集、营销落地页与博客。
    </Fragment>
  </Hero>

  <!-- 数据亮点 -->
  <SocialProof
    id="proof"
    classes={{ container: '!pb-14 md:!pb-20' }}
    items={[
      {
        value: '6.1K',
        label: 'GitHub Star，Astro 生态最受欢迎的主题之一',
        icon: 'tabler:star-filled',
        color: 'text-amber-400',
        href: 'https://github.com/arthelokyo/astrowind',
      },
      { value: '100', label: 'Lighthouse 四项满分', icon: 'tabler:gauge', color: 'text-emerald-500' },
      { value: 'MIT', label: '许可，个人与商用皆免费', icon: 'tabler:license', color: 'text-sky-500' },
    ]}
  />

  <!-- 快速开始 -->
  <QuickStart
    id="quick-start"
    classes={{ icon: 'bg-green-600 dark:bg-green-700' }}
    tagline="快速开始"
    title="一条命令，就是全部初始化工作"
    subtitle="不想先看特性？直接把模板跑起来，两分钟后你就能开始改内容。"
    commands={['bunx create-astro@latest --template arthelokyo/astrowind']}
    items={[
      {
        title: '两分钟，一个终端',
        description:
          '按提示创建项目，运行 <code>bun install</code> 与 <code>bun run dev</code>，打开 localhost:4321，看到的演示站就是你自己的代码。需要 Bun 1.4.4 或更高版本。',
        icon: 'tabler:terminal-2',
      },
      {
        title: '天生适配 AI 助手',
        description:
          '仓库自带 <code>AGENTS.md</code> 与 16 个分步技能文档，Claude Code、Cursor、Codex 等工具能直接看懂目录约定，帮你加页面、改主题、关博客。',
        icon: 'tabler:sparkles',
      },
      {
        title: 'MIT 许可，没有附加条件',
        description:
          '客户项目、个人站点、公司官网都可以用。不必保留署名，也无需付费；如果它帮你省下一个下午，去 GitHub 点个 Star 就好。',
        icon: 'tabler:license',
      },
    ]}
  >
    <Fragment slot="bg">
      <div class="absolute inset-0 bg-[radial-gradient(60%_55%_at_15%_20%,rgb(129_140_248/0.28),transparent_65%),radial-gradient(50%_50%_at_85%_25%,rgb(244_114_182/0.22),transparent_65%)] [mask-image:linear-gradient(to_bottom,transparent,#000_14%,#000_86%,transparent)] dark:bg-[radial-gradient(60%_55%_at_15%_20%,rgb(99_102_241/0.25),transparent_65%),radial-gradient(50%_50%_at_85%_25%,rgb(217_70_239/0.18),transparent_65%)]"></div>
    </Fragment>
  </QuickStart>

  <!-- 核心特性 -->
  <Features
    id="features"
    tagline="核心特性"
    title="AstroWind 给你准备了什么"
    subtitle="一套面向生产环境的静态站点骨架：性能、SEO、内容与组件都已在模板里就位，你只需要换成自己的文案与图片。"
    items={[
      {
        title: 'Astro v7 + Tailwind CSS v4',
        description:
          '静态优先的 Astro 搭配 CSS-first 配置的 Tailwind v4，几乎不向浏览器发送 JavaScript，页面又快又好改。',
        icon: 'tabler:brand-tailwind',
      },
      {
        title: '30+ 可组合页面区块',
        description:
          'Hero、特性、Bento、价格对比、FAQ、客户评价、团队、时间线、图库等区块全部带类型定义，按需拼装即可。',
        icon: 'tabler:components',
      },
      {
        title: '开箱即用的博客',
        description: 'Markdown / MDX 文章放在 src/data/post/，自动获得 RSS、分类、标签、相关文章、社交分享与阅读时长。',
        icon: 'tabler:article',
      },
      {
        title: 'SEO 与结构化数据',
        description: '按路由生成 sitemap，默认配置 OG / Twitter 卡片、robots 与 JSON-LD，PageSpeed Insights 四项满分。',
        icon: 'tabler:seo',
      },
      {
        title: '暗色模式与图片优化',
        description: '深浅主题、RTL、shadcn/ui 兼容的设计变量；本地图由 Sharp 优化，远程图交给 Unpic 走 CDN。',
        icon: 'tabler:moon-stars',
      },
      {
        title: '为 AI 助手写好说明书',
        description: 'AGENTS.md、CLAUDE.md 与 .agents/skills/ 把常见改造任务写成分步指南，让 AI 改代码有据可依。',
        icon: 'tabler:bulb',
      },
    ]}
  />

  <!-- 架构说明 -->
  <Content
    isReversed
    tagline="模板内部"
    title="看懂 AstroWind 的结构，改起来才不迷路"
    items={[
      {
        title: '配置集中在 config.yaml',
        description:
          '站点名、URL、SEO、博客开关与分析都写在 src/config.yaml，由自研 Astro integration 编译成虚拟模块 astrowind:config。',
      },
      {
        title: '页面基于文件路由',
        description: 'src/pages/ 下的 .astro 与 .md 文件自动成为路由，动态路由负责博客列表、文章、分类与标签。',
      },
      {
        title: '内容走 Content Layer',
        description: 'src/content.config.ts 用 glob() 加载器读取 src/data/post/ 下的文章，构建时完成校验与渲染。',
      },
    ]}
    image={{
      src: 'https://images.unsplash.com/photo-1519389950473-47ba0277781c?ixlib=rb-4.0.3&ixid=M3wxMjA3fDB8MHxwaG90by1wYWdlfHx8fGVufDB8fHx8fA%3D%3D&auto=format&fit=crop&w=2070&q=80',
      alt: '团队协作开发网站',
      aspect: '4/3',
    }}
  >
    <Fragment slot="content">
      <h3 class="text-2xl font-bold tracking-tight dark:text-white sm:text-3xl mb-2">建立在现代化基础之上</h3>
      把约定写进代码里，让每一次改动都落在正确的地方
    </Fragment>

    <Fragment slot="bg">
      <div class="absolute inset-0 bg-blue-50 dark:bg-transparent"></div>
    </Fragment>
  </Content>

  <!-- 定制能力 -->
  <Content
    isAfterContent
    items={[
      {
        title: '颜色与字体都是变量',
        description:
          'CustomStyles.astro 定义明暗两套 CSS 变量，tailwind.css 用 @theme 暴露设计 token，改一处即可全局换肤。',
      },
      {
        title: '多种页面版式',
        description: '首页、落地页、博客页与 Markdown 页各有一套布局，区块组件可以任意组合成新的版式。',
      },
      {
        title: '完全响应式',
        description: '从手机到大屏都有一致的阅读体验，移动端菜单、图片尺寸与间距都已处理妥当。',
      },
      {
        title: '媒体与嵌入内容',
        description: '内置图片、视频、社交嵌入组件，配合 Astro 资源管线自动压缩与懒加载。',
      },
    ]}
    image={{
      src: 'https://images.unsplash.com/photo-1616674282942-2835e62d612e?auto=format&fit=crop&w=1600&q=80',
      alt: '桌面上的网站线框图',
      aspect: '4/3',
    }}
  >
    <Fragment slot="content">让站点真正长成你自己的样子。</Fragment>
  </Content>

  <!-- 效率 -->
  <Content
    isReversed
    isAfterContent
    items={[
      {
        title: '不必从零搭轮子',
        description: '导航栏、页脚、面包屑、分页、标签、分享按钮这些重复工作，模板已经写好并且带类型。',
      },
      {
        title: '静态产物随处可部署',
        description:
          'output: static 产出 dist/ 纯静态文件，Vercel、Netlify、Cloudflare Workers、nginx 容器都能直接托管。',
      },
      {
        title: '持续维护的依赖',
        description: 'v1 处于维护模式，持续接收依赖升级与问题修复，Astro 与 Tailwind 大版本更新也会跟进。',
      },
      {
        title: '社区与文档',
        description: '1,300+ 次提交、1700+ fork，加上 16 个 AI 技能文档，遇到问题几乎总能找到参考。',
      },
    ]}
    image={{
      src: 'https://images.unsplash.com/photo-1611462985358-60d3498e0364?ixlib=rb-4.0.3&ixid=M3wxMjA3fDB8MHxwaG90by1wYWdlfHx8fGVufDB8fHx8fA%3D%3D&auto=format&fit=crop&w=2070&q=80',
      alt: '开发工作流示意',
      aspect: '4/3',
    }}
  >
    <Fragment slot="content">把时间留给内容，而不是脚手架。</Fragment>
  </Content>

  <!-- 上手步骤 -->
  <Steps
    title="四步，把模板变成你的网站"
    items={[
      {
        title: '第 1 步：<span class="font-medium">获取模板</span>',
        description:
          '在 GitHub 上 fork 或点击 Use this template，也可以用上面的命令直接创建项目。整个代码库立刻属于你。',
        icon: 'tabler:package',
      },
      {
        title: '第 2 步：<span class="font-medium">替换内容</span>',
        description:
          '改 src/config.yaml 里的站点信息与 logo，替换首页与 src/data/post/ 里的示例文字，把图片换成自己的素材。',
        icon: 'tabler:letter-case',
      },
      {
        title: '第 3 步：<span class="font-medium">调整外观</span>',
        description:
          '在 CustomStyles.astro 改明暗主题颜色，在 astro.config.ts 的 fonts 配置里换字体，用现成区块重新拼装页面。',
        icon: 'tabler:paint',
      },
      {
        title: '完成，可以上线了',
        icon: 'tabler:check',
      },
    ]}
    image={{
      src: 'https://images.unsplash.com/photo-1616198814651-e71f960c3180?ixlib=rb-4.0.3&ixid=M3wxMjA3fDB8MHxwaG90by1wYWdlfHx8fGVufDB8fHx8fA%3D%3D&auto=format&fit=crop&w=987&q=80',
      alt: '从想法到上线的步骤',
    }}
  />

  <!-- 组件目录 -->
  <Features2
    id="components"
    title="常用页面区块一览"
    subtitle="每个区块都是带类型 props 的 .astro 组件，页面只是把它们的顺序和文案组合起来"
    tagline="组件库"
    items={[
      {
        title: '导航与页脚',
        description: '桌面下拉菜单、移动端折叠菜单、主题切换、RSS 入口与多栏页脚。',
        icon: 'flat-color-icons:template',
      },
      {
        title: '首屏 Hero',
        description: '标题、副标题、行动按钮与主视觉，支持多种排版变体。',
        icon: 'flat-color-icons:gallery',
      },
      {
        title: '特性与卖点',
        description: '网格、Bento、标签页、步骤与时间线，把能力讲清楚。',
        icon: 'flat-color-icons:approval',
      },
      {
        title: '内容区块',
        description: '图文左右分栏、引用、注释与图库，承载长篇说明。',
        icon: 'flat-color-icons:document',
      },
      {
        title: '行动号召',
        description: 'CTA、公告条、粘性按钮与订阅表单，把读者导向下一步。',
        icon: 'flat-color-icons:advertising',
      },
      {
        title: '价格与对比',
        description: '价格卡片与功能对比表，适合 SaaS 与产品页。',
        icon: 'flat-color-icons:currency-exchange',
      },
      {
        title: '客户评价',
        description: '评价、社会证明、数据统计与品牌墙，建立信任感。',
        icon: 'flat-color-icons:voice-presentation',
      },
      {
        title: '联系与团队',
        description: '联系表单、团队介绍、项目展示与常见问题折叠面板。',
        icon: 'flat-color-icons:business-contact',
      },
      {
        title: '博客组件',
        description: '文章卡片、列表、分页、标签、相关文章与 RSS 输出。',
        icon: 'flat-color-icons:database',
      },
    ]}
  >
    <Fragment slot="bg">
      <div class="absolute inset-0 bg-blue-50 dark:bg-transparent"></div>
    </Fragment>
  </Features2>

  <!-- 项目历程 -->
  <Timeline
    id="story"
    layout="alternate"
    tagline="项目历程"
    title="一个模板，从 2022 年走到今天"
    subtitle="从 Astro 1.0 beta 时代起步，跟随每一次大版本演进，也由社区的贡献者一点点打磨。"
    items={[
      {
        date: '2022 年 6 月',
        title: '诞生在 Astro 1.0 beta 时期',
        description: '最初只有几个页面和少量区块，思路却很明确：网站可以同时做到快、简单、好看。',
        icon: 'tabler:rocket',
      },
      {
        date: '2022 年',
        title: '成为 Star 最多的 Astro 主题',
        description: '年底登上 Astro 生态榜首，此后连续多年保持这一位置，第一批来自陌生开发者的 PR 也陆续到来。',
        icon: 'tabler:star-filled',
      },
      {
        date: '2022–2023',
        title: '最忙碌的一段时期',
        description: '内容集合、图片优化、页面过渡相继加入，区块数量翻倍，博客逐渐成型。',
        icon: 'tabler:users-group',
      },
      {
        date: '2024 年',
        title: '打磨细节',
        description: '跟随 Astro 4 更新，大部分提交来自贡献者：可访问性、工具链、编辑与部署方式的改进。',
        icon: 'tabler:puzzle',
      },
      {
        date: '2025 年',
        title: '稳定迭代',
        description: '升级 Astro 5，提交节奏放缓但没有停，Star 数在 10 月突破五千。',
        icon: 'tabler:refresh',
      },
      {
        date: '2026 年',
        title: 'Astro 7 与 Tailwind CSS 4',
        description: '一年内跟进两个框架大版本：新一代区块、完整落地页示例、更像文档的博客，以及写给 AI 助手的指南。',
        icon: 'tabler:sparkles',
      },
      {
        date: '2026 年',
        title: 'v1 趋于完整',
        description: '首次提交四年后，演示站里不再有占位内容：每个页面、每篇示例文章都是真实的。',
        icon: 'tabler:circle-check-filled',
        highlight: true,
      },
      { icon: 'tabler:dots', ghost: true },
    ]}
  />

  <!-- 中文文章 -->
  <BlogHighlightedPosts
    title="继续阅读中文指南"
    linkText="查看全部文章"
    postIds={[
      'get-started-website-with-astro-tailwind-css',
      'how-to-customize-astrowind-to-your-brand',
      'astrowind-template-in-depth',
      'build-websites-with-ai',
    ]}
    information="这几篇文章从安装、定制讲到模板原理与 AI 协作，按需要挑一篇开始即可。所有示例文章都放在 src/data/post/，构建时自动进入列表、分类、标签与 RSS。"
  />

  <!-- 常见问题 -->
  <FAQs
    id="faqs"
    title="常见问题"
    subtitle="在克隆仓库之前最常被问到的几个问题。更复杂的操作步骤，仓库里的 .agents/skills/ 已经写成了分步指南。"
    tagline="FAQ"
    schema
    items={[
      {
        title: 'AstroWind 是什么？',
        description:
          '一个基于 Astro v7 与 Tailwind CSS v4 的免费开源静态站点模板：包含页头页脚、30+ 可复用区块、Markdown/MDX 博客、暗色模式、RTL、图片优化、SEO 元信息与 RSS，改完内容即可部署到任意静态托管。',
      },
      {
        title: '开始之前需要准备什么？',
        description:
          'Bun 1.4.4 或更高版本（<code>packageManager</code> 中已固定）和一个终端。运行 <code>bunx create-astro@latest --template arthelokyo/astrowind</code>，再 <code>bun install</code> 与 <code>bun run dev</code>。站点信息在 <code>src/config.yaml</code>，颜色字体在 <code>src/components/CustomStyles.astro</code>。',
      },
      {
        title: '不需要博客，可以关掉吗？',
        description:
          '可以。把 <code>src/config.yaml</code> 里的 <code>apps.blog.isEnabled</code> 设为 <code>false</code>，博客路由、RSS 与文章区块都会从构建产物中消失，其余部分不受影响。',
      },
      {
        title: '怎么换颜色、字体和 Logo？',
        description:
          '颜色是 <code>CustomStyles.astro</code> 里的明暗两套 CSS 变量；字体在 <code>astro.config.ts</code> 的 fonts 配置里通过 Astro Fonts API 自托管；Logo 是 <code>src/components/Logo.astro</code>。这些变量同时喂给 shadcn/ui 兼容的设计 token。',
      },
      {
        title: '真的能让 AI 助手直接改吗？',
        description:
          '仓库自带 <code>AGENTS.md</code> 约定与 <code>.agents/skills/</code> 下 16 个分步技能（关博客、换 OG 图、子路径部署、接 CMS、部署 Cloudflare 等），Claude Code、Codex、Cursor 都能按指南可靠完成任务。',
      },
      {
        title: '能部署到哪里，需要付费吗？',
        description:
          '任何能托管静态文件的地方：Vercel、Netlify、Cloudflare Workers、GitHub Pages、nginx 容器（仓库自带 Dockerfile）或自己的服务器。模板采用 MIT 许可，个人与商业项目都免费。',
      },
    ]}
  />

  <!-- 数字 -->
  <Stats
    id="stats"
    countUp
    stats={[
