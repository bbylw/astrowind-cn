---
import type { InferGetStaticPropsType, GetStaticPaths } from 'astro';

import Layout from '~/layouts/PageLayout.astro';
import BlogList from '~/components/blog/List.astro';
import Headline from '~/components/blog/Headline.astro';
import Pagination from '~/components/blog/Pagination.astro';
import Newsletter from '~/components/widgets/Newsletter.astro';
import Breadcrumbs from '~/components/common/Breadcrumbs.astro';
import { getPermalink, getBlogPermalink } from '~/utils/permalinks';

import { blogListRobots, getStaticPathsBlogList } from '~/utils/blog';

export const prerender = true;

export const getStaticPaths = (async ({ paginate }) => {
  return await getStaticPathsBlogList({ paginate });
}) satisfies GetStaticPaths;

type Props = InferGetStaticPropsType<typeof getStaticPaths>;

const { page } = Astro.props as Props;
const currentPage = page.currentPage ?? 1;

const breadcrumbs = [
  { text: '首页', href: getPermalink('/') },
  ...(currentPage > 1
    ? [{ text: '中文指南', href: getBlogPermalink() }, { text: `第 ${currentPage} 页` }]
    : [{ text: '中文指南' }]),
];

const metadata = {
  title: `中文指南${currentPage > 1 ? ` — 第 ${currentPage} 页` : ''}`,
  description: '关于 AstroWind 模板的中文指南：安装上手、品牌定制、原理拆解、AI 协作与建站资源。',
  robots: {
    index: blogListRobots?.index && currentPage === 1,
    follow: blogListRobots?.follow,
  },
  openGraph: {
    type: 'blog',
  },
};
---

<Layout metadata={metadata}>
  <Fragment slot="head">
    {page.url.prev && <link rel="prev" href={page.url.prev} />}
    {page.url.next && <link rel="next" href={page.url.next} />}
  </Fragment>
  <Breadcrumbs bar items={breadcrumbs} />
  <section class="px-6 sm:px-6 py-12 sm:py-16 lg:py-20 mx-auto max-w-4xl">
    <Headline subtitle="从安装、定制到模板原理与 AI 协作，用中文把 AstroWind 讲清楚">中文指南</Headline>
    <BlogList posts={page.data} />
    <Pagination prevUrl={page.url.prev} nextUrl={page.url.next} />
  </section>
  <Newsletter
    tagline="订阅"
    title="新文章发布时通知你"
    subtitle="只发送与 Astro、Tailwind CSS 和本模板相关的中文内容，不夹带其他东西。"
    button="订阅"
    disclaimer="随时可以取消。这是模板示例表单：传入 <code>action</code> 才能接到你的邮件服务。"
    classes={{ container: 'max-w-4xl' }}
  />
</Layout>
