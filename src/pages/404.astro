---
import Layout from '~/layouts/Layout.astro';
import Button from '~/components/ui/Button.astro';
import { getHomePermalink } from '~/utils/permalinks';

const title = '页面未找到（404）';
---

<Layout metadata={{ title }}>
  <section class="grid flex-1 place-items-center px-4 py-20 md:py-28">
    <div class="max-w-md text-center">
      <p class="font-heading text-7xl font-bold leading-none tracking-tighter text-primary md:text-8xl">404</p>
      <h1 class="mt-6 font-heading text-2xl font-bold leading-[1.14] text-heading md:text-3xl break-keep">
        抱歉，没有找到这个页面。
      </h1>
      <p class="mt-3 text-base text-muted dark:text-slate-400">别担心，首页上有关于 AstroWind 的全部中文介绍。</p>
      <div class="mt-8 flex justify-center">
        <Button variant="primary" href={getHomePermalink()}>
          返回首页
        </Button>
      </div>
    </div>
  </section>
</Layout>
